{
  "mcpServers": {
    "cinelogic-studio": {
      "command": "python3",
      "args": [
        "cinelogic/mcp/server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "cinelogic-motion": {
      "command": "python3",
      "args": [
        "cinelogic/mcp/image_motion_server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
